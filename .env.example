# Copy to .env and replace every placeholder before deploying.
# The development defaults in application-dev.yml are NOT safe for production.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082
DOCKER_COMPOSE_ENABLED=false

# PostgreSQL (compose.yaml defaults shown)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Required in production: HS256 secret, at least 32 bytes.
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_ISSUER=electricwave
APP_JWT_EXPIRATION=15m
APP_JWT_REFRESH_EXPIRATION=30d

# Required in production: base64 encoding of exactly 32 random bytes.
# Generate with: openssl rand -base64 32
APP_CRYPTO_MASTER_KEY=replace-with-base64-32-byte-key

# Bootstrap admin, created only when no ADMIN exists.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-password
APP_ADMIN_NAME=System Administrator

# Native Google sign-in (ID token audience).
APP_OAUTH2_GOOGLE_CLIENT_ID=

# SMTP
APP_MAIL_ENABLED=true
APP_MAIL_FROM=no-reply@example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Emoncms upstream
APP_EMONCMS_BASE_URL=https://emoncms.example.com
APP_EMONCMS_VALIDATE_ON_SAVE=false

# Only trust X-Forwarded-For when the direct peer is one of these proxies.
APP_TRUSTED_PROXIES=
APP_HTTP_MAX_REQUEST_BYTES=1048576

# Never enable in production.
APP_AUTH_EXPOSE_VERIFICATION_CODE=false
APP_OPENAPI_ENABLED=false

# Rate limits
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_LOGIN_IP_PER_MINUTE=10
APP_RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=5
APP_RATE_LIMIT_REGISTER_IP_PER_HOUR=5
APP_RATE_LIMIT_VERIFY_IP_PER_10_MINUTES=20
APP_RATE_LIMIT_RESEND_EMAIL_PER_10_MINUTES=3
APP_RATE_LIMIT_RESEND_IP_PER_HOUR=10
APP_RATE_LIMIT_REFRESH_IP_PER_MINUTE=30
APP_RATE_LIMIT_GOOGLE_IP_PER_10_MINUTES=10
APP_RATE_LIMIT_CLAIM_PER_USER_PER_MINUTE=5
APP_RATE_LIMIT_CLAIM_PER_IP_PER_MINUTE=20
APP_RATE_LIMIT_FORGOT_PER_EMAIL_PER_HOUR=3
APP_RATE_LIMIT_FORGOT_PER_IP_PER_HOUR=10
APP_RATE_LIMIT_RESET_PER_IP_PER_10_MINUTES=10
APP_RATE_LIMIT_GATEWAY_PER_USER_PER_MINUTE=300
APP_RATE_LIMIT_CHANGE_PASSWORD_PER_USER_PER_10_MINUTES=5
