# Copy to .env and replace every placeholder before deploying.
# The development defaults in application-dev.yml are NOT safe for production.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082
DOCKER_COMPOSE_ENABLED=false

# PostgreSQL (compose.yaml defaults shown)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=change-me
# Connection pool ceiling. Audited requests hold two connections at once (the business
# transaction plus the nested audit write), so keep headroom above peak concurrency.
DB_POOL_MAX_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty locally, where Redis is reachable only from this machine. Set it in any
# deployment: this instance stores every refresh token, so reaching it is enough to
# mint sessions for the whole fleet.
REDIS_PASSWORD=

# Required in production: HS256 secret, at least 32 bytes.
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_ISSUER=electricwave
APP_JWT_EXPIRATION=15m
APP_JWT_REFRESH_EXPIRATION=30d

# Required in production: base64 encoding of exactly 32 random bytes.
# Generate with: openssl rand -base64 32
APP_CRYPTO_MASTER_KEY=replace-with-base64-32-byte-key

# Bootstrap admin, created only when no ADMIN exists.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-password
APP_ADMIN_NAME=System Administrator

# Native Google sign-in (ID token audience).
APP_OAUTH2_GOOGLE_CLIENT_ID=

# Mail
APP_MAIL_ENABLED=true
APP_MAIL_FROM=no-reply@example.com

# How mail leaves the process: smtp (the default, used locally) or brevo (Brevo's HTTP
# API). Use brevo wherever outbound SMTP is blocked - Render drops 25/465/587, so a
# JavaMail connect there hangs for the full timeout and then fails on every send.
APP_MAIL_TRANSPORT=smtp

# transport=smtp only. Port 2525 is an alternative submission port that some platforms
# leave open when they block 587; Brevo supports it on smtp-relay.brevo.com. The
# password here is Brevo's SMTP key, not its API key.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Announced in EHLO and used for the Message-ID domain. Set it to a real domain: the
# default is a .local name, and resolving this host's own name instead cost ~17s a
# lookup, twice per send.
SPRING_MAIL_LOCALHOST=example.com

# transport=brevo only. The app refuses to start with brevo selected and no key.
APP_MAIL_API_KEY=
APP_MAIL_API_BASE_URL=https://api.brevo.com/v3

# Re-enable the /actuator/health SMTP probe. Off by default because it blocks for the
# full connect timeout and fails the whole endpoint wherever SMTP is unreachable.
APP_MAIL_HEALTH_ENABLED=false

# Site monitoring. Leaving this enabled is what makes alarms exist while nobody has the
# app open; disabling it freezes the alarm list, because no new alarm is raised and no
# open one clears. A sweep only runs while the instance is awake, so keep something
# polling /actuator/health on hosts that sleep when idle.
APP_MONITOR_ENABLED=true
APP_MONITOR_INTERVAL=PT30S
APP_MONITOR_EMONCMS_BASE_URL=http://electricwave.ma/energymonitoring

# Defaults for sites with no site-specific threshold row. These come from an example and
# have not been validated against the real installations; expect to tune them per site.
# A site-specific null disables that check; DELETE the row to return to these defaults.
APP_MONITOR_MAX_POWER=142000
APP_MONITOR_MIN_VOLTAGE=230

# Readings older than this are not judged at all. Clear hysteresis is a fraction of the
# limit: an alarm only clears once the reading is clearly back past it.
APP_MONITOR_STALE_AFTER=PT15M
APP_MONITOR_CLEAR_DEADBAND=0.01
APP_MONITOR_CONCURRENCY=4

# Only trust X-Forwarded-For when the direct peer is one of these proxies.
# REQUIRED when running behind a reverse proxy (nginx, ALB, Cloudflare, an ingress
# controller). Left empty, the app sees the proxy's address as the client address for
# every request, so each per-IP rate limit below becomes ONE bucket shared by all
# clients - the 11th login attempt from anyone in a minute gets a 429. Set it to the
# address(es) of the hop that talks to this app, comma-separated. Leave it empty only
# if clients connect to this instance directly.
APP_TRUSTED_PROXIES=
APP_HTTP_MAX_REQUEST_BYTES=1048576

# Never enable in production.
APP_AUTH_EXPOSE_VERIFICATION_CODE=false
APP_OPENAPI_ENABLED=false

# Rate limits
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_LOGIN_IP_PER_MINUTE=10
APP_RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=5
APP_RATE_LIMIT_REGISTER_IP_PER_HOUR=5
APP_RATE_LIMIT_VERIFY_IP_PER_10_MINUTES=20
APP_RATE_LIMIT_RESEND_EMAIL_PER_10_MINUTES=3
APP_RATE_LIMIT_RESEND_IP_PER_HOUR=10
APP_RATE_LIMIT_REFRESH_IP_PER_MINUTE=30
APP_RATE_LIMIT_GOOGLE_IP_PER_10_MINUTES=10
APP_RATE_LIMIT_CLAIM_PER_USER_PER_MINUTE=5
APP_RATE_LIMIT_CLAIM_PER_IP_PER_MINUTE=20
APP_RATE_LIMIT_FORGOT_PER_EMAIL_PER_HOUR=3
APP_RATE_LIMIT_FORGOT_PER_IP_PER_HOUR=10
APP_RATE_LIMIT_RESET_PER_IP_PER_10_MINUTES=10
APP_RATE_LIMIT_CHANGE_PASSWORD_PER_USER_PER_10_MINUTES=5
